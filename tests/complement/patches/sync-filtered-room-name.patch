+
+// The timeline is applied after the state block and can replace the room name.
+func effectiveRoomNameEvent(joined gjson.Result) string {
+	var id string
+	for _, section := range []string{"state.events", "timeline.events"} {
+		for _, event := range joined.Get(section).Array() {
+			key := event.Get("state_key")
+			if event.Get("type").Str == "m.room.name" && key.Type == gjson.String && key.Str == "" {
+				id = event.Get("event_id").Str
+			}
+		}
+	}
+	return id
 }
